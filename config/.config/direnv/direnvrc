#!/usr/bin/env bash
# shellcheck disable=SC1090

_bw_found=0
for _bw_path in \
    "$HOME/.bashrc.d/bw-common.bashrc" \
    "$HOME/.dotfiles/bash/.bashrc.d/bw-common.bashrc"; do
    if [[ -f "$_bw_path" ]]; then
        source "$_bw_path"
        _bw_found=1
        break
    fi
done
unset _bw_path
if [[ "$_bw_found" -eq 0 ]]; then
    echo "bw-common.bashrc not found" >&2
fi
unset _bw_found

bw_load_vault() {
    _bw_check_deps || return 1
    local session
    session=$(_bw_get_session)

    if [ -z "$session" ]; then
        log_error "Bitwarden session not found. Run 'bw-unlock'."
        return 1
    fi

    if ! BW_SESSION="$session" bw unlock --check &>/dev/null; then
        log_error "Bitwarden session expired or invalid. Run 'bw-unlock'."
        return 1
    fi

    export BW_SESSION="$session"

    _BW_IN_MEMORY_VAULT=$(bw list items 2>/dev/null)

    if [ -z "$_BW_IN_MEMORY_VAULT" ] || [ "$_BW_IN_MEMORY_VAULT" = "null" ]; then
        log_error "Failed to retrieve items from Bitwarden."
        return 1
    fi
}

bw_get() {
    local item_name="$1"
    local field="${2:-password}"

    if [ -z "$_BW_IN_MEMORY_VAULT" ] || [ "$_BW_IN_MEMORY_VAULT" = "null" ]; then
        return 1
    fi

    local field_lower
    field_lower=$(echo "$field" | tr '[:upper:]' '[:lower:]')

    if [ "$field_lower" = "password" ]; then
        echo "$_BW_IN_MEMORY_VAULT" | jq -r --arg name "$item_name" 'first(.[] | select((.name // "" | ascii_downcase) == ($name | ascii_downcase)) | .login.password) // empty'
    elif [ "$field_lower" = "username" ]; then
        echo "$_BW_IN_MEMORY_VAULT" | jq -r --arg name "$item_name" 'first(.[] | select((.name // "" | ascii_downcase) == ($name | ascii_downcase)) | .login.username) // empty'
    elif [ "$field_lower" = "website" ] || [ "$field_lower" = "url" ]; then
        echo "$_BW_IN_MEMORY_VAULT" | jq -r --arg name "$item_name" 'first(.[] | select((.name // "" | ascii_downcase) == ($name | ascii_downcase)) | .login.uris[0].uri) // empty'
    elif [ "$field_lower" = "notes" ]; then
        echo "$_BW_IN_MEMORY_VAULT" | jq -r --arg name "$item_name" 'first(.[] | select((.name // "" | ascii_downcase) == ($name | ascii_downcase)) | .notes) // empty'
    else
        echo "$_BW_IN_MEMORY_VAULT" | jq -r --arg name "$item_name" --arg fld "$field" '
            first(.[] | select((.name // "" | ascii_downcase) == ($name | ascii_downcase)) | .fields[]? | select((.name // "" | ascii_downcase) == ($fld | ascii_downcase)) | .value) // empty
        '
    fi
}
